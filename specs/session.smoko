Feature: bira session and task claim/release

  Background:
    Given I run "bira init --name test-project"

  Scenario: Session start creates a session
    When I run "bira session start"
    Then exit code is 0
    And output contains "Session started:"
    And output contains "export BIRA_SESSION="

  Scenario: Session start --json returns structured output
    When I run "bira session start --json"
    Then exit code is 0
    And output as JSON at path "$.id" exists
    And output as JSON at path "$.project_id" exists

  Scenario: Session start with --label sets label
    When I run "bira session start --label my-agent --json"
    Then exit code is 0
    And output as JSON at path "$.label" equals "my-agent"

  Scenario: Session start with duplicate label fails
    Given I run "bira session start --label agent1"
    When I run "bira session start --label agent1"
    Then exit code is not 0

  Scenario: Session list shows active sessions
    Given I run "bira session start --label list-agent"
    When I run "bira session list"
    Then exit code is 0
    And output contains "list-agent"

  Scenario: Session list --json returns array
    Given I run "bira session start --label json-agent"
    When I run "bira session list --json"
    Then exit code is 0
    And output contains "json-agent"

  Scenario: Session show displays session details
    Given I run "bira session start --label show-agent --json"
    And I save JSON path "$.id" as $SID
    When I run "bira session show $SID"
    Then exit code is 0
    And output contains "show-agent"
    And output contains "Session:"

  Scenario: Session show unknown ID returns exit 2
    When I run "bira session show deadbeef"
    Then exit code is 2

  Scenario: Session end releases claimed tasks
    Given I run "bira session start --label end-agent --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add end-task --desc d --assign end-agent --criteria c --json"
    And I save JSON path "$.id" as $TID
    Given I run "bira task claim $TID --session $SID"
    When I run "bira session end $SID"
    Then exit code is 0
    And output contains "ended"

  Scenario: Session end --json returns released tasks list
    Given I run "bira session start --label ej-agent --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add ej-task --desc d --assign ej-agent --criteria c --json"
    And I save JSON path "$.id" as $TID
    Given I run "bira task claim $TID --session $SID"
    When I run "bira session end $SID --json"
    Then exit code is 0
    And output as JSON at path "$.released_tasks" exists

  Scenario: Session end --release-status blocked sets released tasks to blocked
    Given I run "bira session start --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add end-blocked-task --desc d --criteria c --json"
    And I save JSON path "$.id" as $TID
    Given I run "bira task claim $TID --session $SID"
    When I run "bira session end $SID --release-status blocked --json"
    Then exit code is 0
    And output as JSON at path "$.released_tasks[0]" exists

  Scenario: Task claim marks task as in-progress
    Given I run "bira session start --label claim-agent --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add claim-task --desc d --assign claim-agent --criteria c --json"
    And I save JSON path "$.id" as $TID
    When I run "bira task claim $TID --session $SID --json"
    Then exit code is 0
    And output as JSON at path "$.status" equals "in-progress"
    And output as JSON at path "$.claimed_by" exists

  Scenario: Task claim without session ID fails
    Given I run "bira task add t1 --desc d --assign a --criteria c --json"
    And I save JSON path "$.id" as $TID
    When I run "bira task claim $TID"
    Then exit code is not 0

  Scenario: Task claim on non-ready task fails
    Given I run "bira session start --label nr-agent --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add not-ready-task --json"
    And I save JSON path "$.id" as $TID
    When I run "bira task claim $TID --session $SID"
    Then exit code is not 0

  Scenario: Task release returns task to pool
    Given I run "bira session start --label rel-agent --json"
    And I save JSON path "$.id" as $SID
    Given I run "bira task add rel-task --desc d --assign rel-agent --criteria c --json"
    And I save JSON path "$.id" as $TID
    Given I run "bira task claim $TID --session $SID"
    When I run "bira task release $TID --session $SID --json"
    Then exit code is 0
    And output as JSON at path "$.status" equals "todo"
